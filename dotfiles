#!/usr/bin/env bash
set -e

# Thin wrapper — clones the dotfiles repo, then hands off to remote-install.sh
DOTFILES_DIR="$HOME/.dotfiles"
REPO="https://github.com/griffinaddison/dotfiles.git"

if [[ -d "$DOTFILES_DIR" ]]; then
    echo "Updating dotfiles..."
    git -C "$DOTFILES_DIR" pull
    git -C "$DOTFILES_DIR" submodule update --init --recursive
else
    echo "Cloning dotfiles..."
    git clone --recurse-submodules "$REPO" "$DOTFILES_DIR"
fi

exec bash "$DOTFILES_DIR/remote-install.sh" "$@"
